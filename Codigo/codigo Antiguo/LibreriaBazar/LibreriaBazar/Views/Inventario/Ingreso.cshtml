@model IngresoViewModel
@{
    ViewData["Title"] = "Ingreso de mercadería";
}

<h1>Ingreso de mercadería</h1>

<form asp-action="Ingreso" method="post" class="card">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-grid">
        <div class="field">
            <label asp-for="ProductoId"></label>
            <select asp-for="ProductoId" asp-items="(SelectList)ViewBag.Productos">
                <option value="0">— Seleccione —</option>
            </select>
            <span asp-validation-for="ProductoId" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Cantidad">Cantidad que ingresa</label>
            <input asp-for="Cantidad" type="number" step="1" min="1" />
            <span asp-validation-for="Cantidad" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="CostoUnitario"></label>
            <input asp-for="CostoUnitario" type="number" step="0.01" min="0" />
            <span asp-validation-for="CostoUnitario" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="ProveedorId"></label>
            <select asp-for="ProveedorId" asp-items="(SelectList)ViewBag.Proveedores">
                <option value="">— Ninguno —</option>
            </select>
        </div>

        <div class="field completo">
            <label asp-for="Observacion">Observación</label>
            <input asp-for="Observacion" maxlength="200" />
            <span asp-validation-for="Observacion" class="field-error"></span>
        </div>
    </div>

    <div class="actions">
        <button type="submit" class="btn btn-primary">Registrar ingreso</button>
        <a class="btn" asp-action="Index">Cancelar</a>
    </div>
</form>
