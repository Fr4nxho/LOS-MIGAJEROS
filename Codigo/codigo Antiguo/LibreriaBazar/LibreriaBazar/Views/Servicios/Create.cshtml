@model Servicio
@{
    ViewData["Title"] = "Nuevo servicio";
}

<h1>Nuevo servicio</h1>

<form asp-action="Create" method="post" class="card">
    <partial name="_Form" model="Model" />
    <div class="actions">
        <button type="submit" class="btn btn-primary">Guardar servicio</button>
        <a class="btn" asp-action="Index">Cancelar</a>
    </div>
</form>
