@model LibreriaBazarRosita.Web.Models.ViewModels.CrearItemViewModel

@{
    ViewData["Title"] = "Registrar producto o servicio";
}

<div class="container mt-4">

    <h2>Registrar producto o servicio</h2>

    <p class="text-muted">
        Librería Bazar Rosita
    </p>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="Catalogo"
                  asp-action="Crear"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre"
                           class="form-label"></label>

                    <input asp-for="Nombre"
                           class="form-control" />

                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TipoItem"
                           class="form-label"></label>

                    <select asp-for="TipoItem"
                            class="form-select">

                        <option value="PRODUCTO">Producto</option>
                        <option value="SERVICIO">Servicio</option>

                    </select>

                    <span asp-validation-for="TipoItem"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio"
                           class="form-label"></label>

                    <input asp-for="Precio"
                           type="number"
                           min="0"
                           max="99999999.99"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="Precio"
                          class="text-danger"></span>
                </div>

                <!-- Datos exclusivos de productos -->
                <div id="datosProducto">

                    <hr />

                    <h5>Información de inventario</h5>

                    <div class="mb-3">
                        <label asp-for="IdCategoria"
                               class="form-label"></label>

                        <select asp-for="IdCategoria"
                                asp-items="ViewBag.Categorias"
                                class="form-select">

                            <option value="">
                                Seleccione una categoría
                            </option>

                        </select>

                        <span asp-validation-for="IdCategoria"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StockInicial"
                               class="form-label"></label>

                        <input asp-for="StockInicial"
                               type="number"
                               min="0"
                               step="1"
                               class="form-control" />

                        <span asp-validation-for="StockInicial"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StockMinimo"
                               class="form-label"></label>

                        <input asp-for="StockMinimo"
                               type="number"
                               min="0"
                               step="1"
                               class="form-control" />

                        <span asp-validation-for="StockMinimo"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-success">
                        Guardar
                    </button>

                    <a asp-controller="Catalogo"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const selectorTipo =
                document.getElementById("TipoItem");

            const datosProducto =
                document.getElementById("datosProducto");

            function actualizarFormulario() {

                const esProducto =
                    selectorTipo.value === "PRODUCTO";

                datosProducto.style.display =
                    esProducto ? "block" : "none";
            }

            selectorTipo.addEventListener(
                "change",
                actualizarFormulario
            );

            actualizarFormulario();
        });
    </script>
}
