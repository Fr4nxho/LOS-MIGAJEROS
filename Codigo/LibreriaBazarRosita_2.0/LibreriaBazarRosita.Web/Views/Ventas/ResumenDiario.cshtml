@model LibreriaBazarRosita.Web.Models.ViewModels.ResumenDiarioViewModel

@{
    ViewData["Title"] = "Resumen diario";
}

<div class="container mt-4">

    <h2>Resumen diario de ventas</h2>

    <form asp-controller="Ventas"
          asp-action="ResumenDiario"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-4">
            <label for="fecha" class="form-label">
                Fecha
            </label>

            <input type="date"
                   id="fecha"
                   name="fecha"
                   value="@Model.Fecha.ToString("yyyy-MM-dd")"
                   class="form-control" />
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Consultar
            </button>
        </div>

    </form>

    <h5 class="mb-3">
        @Model.Fecha.ToString("dd/MM/yyyy")
    </h5>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6>Ventas completadas</h6>
                    <h3>@Model.CantidadVentas</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6>Subtotal</h6>
                    <h3>S/ @Model.Subtotal.ToString("0.00")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6>Descuentos</h6>
                    <h3>S/ @Model.Descuentos.ToString("0.00")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-success h-100">
                <div class="card-body">
                    <h6>Ingresos totales</h6>
                    <h3 class="text-success">
                        S/ @Model.Ingresos.ToString("0.00")
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <h5>Ingresos por medio de pago</h5>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead class="table-dark">
                <tr>
                    <th>Medio de pago</th>
                    <th>Ventas</th>
                    <th>Importe</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.MediosPago.Any())
                {
                    @foreach (var medio in Model.MediosPago)
                    {
                        <tr>
                            <td>@medio.MedioPago</td>
                            <td>@medio.Cantidad</td>
                            <td>S/ @medio.Total.ToString("0.00")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3"
                            class="text-center text-muted py-4">

                            No se registraron ventas completadas
                            en la fecha seleccionada.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <a asp-controller="Ventas"
       asp-action="Historial"
       class="btn btn-outline-secondary mt-3">

        Volver al historial

    </a>

</div>
