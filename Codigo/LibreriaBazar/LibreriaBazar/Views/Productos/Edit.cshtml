@model Producto
@{
    ViewData["Title"] = "Editar producto";
    ViewData["Edicion"] = true;
}

<h1>Editar producto</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    <partial name="_Form" model="Model" />
    <div class="actions">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a class="btn" asp-action="Index">Cancelar</a>
    </div>
</form>
