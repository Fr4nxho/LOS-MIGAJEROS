@model Servicio

<div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
<input type="hidden" asp-for="Id" />

<div class="form-grid">
    <div class="field">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" maxlength="120" />
        <span asp-validation-for="Nombre" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Precio" class="field-error"></span>
    </div>

    <div class="field completo">
        <label asp-for="Descripcion"></label>
        <input asp-for="Descripcion" maxlength="250" />
        <span asp-validation-for="Descripcion" class="field-error"></span>
    </div>
</div>
